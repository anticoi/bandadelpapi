{
  "version": 2,
  "functions": {
    "api/chat.js": { "maxDuration": 60 },
    "api/logs.js": { "maxDuration": 10 },
    "api/events.js": { "maxDuration": 10 },
    "api/reservas.js": { "maxDuration": 10 },
    "api/blog.js": { "maxDuration": 10 },
    "api/testimonios.js": { "maxDuration": 10 },
    "api/newsletter.js": { "maxDuration": 10 },
    "api/photos.js": { "maxDuration": 10 },
    "api/videos.js": { "maxDuration": 10 },
    "api/config.js": { "maxDuration": 10 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
